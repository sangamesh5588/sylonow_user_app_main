# ─── Sylonow User App — Environment Variables Reference ────────────────────
# Copy this file to supabase/functions/.env and fill in real values.
# NEVER commit actual secrets. supabase/functions/.env is gitignored.
#
# Production: set via Supabase Dashboard → Project Settings → Edge Functions → Secrets

# ─── MSG91 OTP ──────────────────────────────────────────────────────────────
# Auth key from MSG91 Dashboard (control.msg91.com → Account → Auth Key)
MSG91_AUTH_TOKEN=your_msg91_authkey_here
MSG91_AUTHKEY=your_msg91_authkey_here

# Widget ID from your MSG91 OTP widget URL (not a secret)
MSG91_WIDGET_ID=366274677442303433393835

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ─── Razorpay (Edge Function secrets) ───────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_SN0TokZm9jZo7T
RAZORPAY_KEY_SECRET=DQvocbFc7FSNAAjVa3mypdPn
